# ---- Database (PostgreSQL via Prisma) ----
# Connection string for PostgreSQL (Vercel Postgres, Neon, Supabase, etc.).
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# ---- Admin ----
# Email that receives new-booking notifications.
ADMIN_EMAIL=you@example.com
# Password used to access the hidden /admin dashboard.
ADMIN_PASSWORD=change-me

# ---- Resend (production email) ----
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Sender address (verify your domain in Resend first).
RESEND_FROM="4th Quarter Performance & Health <onboarding@resend.dev>"
