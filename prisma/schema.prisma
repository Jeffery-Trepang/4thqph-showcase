generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A bookable session/time-slot created by the admin. No capacity limit.
model Session {
  id        Int       @id @default(autoincrement())
  date      String // YYYY-MM-DD (kept as a string to avoid timezone ambiguity)
  startTime String // HH:MM (24h)
  endTime   String // HH:MM (24h)
  type      String // one of the four session types
  notes     String?
  status    String    @default("active") // "active" | "completed" | "cancelled"
  createdAt DateTime  @default(now())
  bookings  Booking[]
}

// A customer registration for a session. Participants are only recorded.
model Booking {
  id           Int      @id @default(autoincrement())
  sessionId    Int
  session      Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  firstName    String
  lastName     String
  email        String
  participants Int
  gender       String
  attended     Boolean  @default(false)
  createdAt    DateTime @default(now())
}
